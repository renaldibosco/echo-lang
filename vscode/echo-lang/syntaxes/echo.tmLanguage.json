{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Echo",
  "scopeName": "source.echo",
  "patterns": [
    {
      "name": "comment.line.number-sign.echo",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.triple.echo",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#interp"
        }
      ]
    },
    {
      "name": "string.quoted.double.echo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.echo",
          "match": "\\\\."
        },
        {
          "include": "#interp"
        }
      ]
    },
    {
      "name": "string.quoted.single.echo",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.echo",
          "match": "\\\\."
        },
        {
          "include": "#interp"
        }
      ]
    },
    {
      "match": "\\b(define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.echo"
        },
        "2": {
          "name": "entity.name.function.echo"
        }
      }
    },
    {
      "match": "\\b(record)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.echo"
        },
        "2": {
          "name": "entity.name.type.echo"
        }
      }
    },
    {
      "name": "keyword.control.echo",
      "match": "\\b(set|to|say|ask|into|if|then|else|end|repeat|times|while|for|each|in|from|step|break|continue|stop|skip|define|return|try|catch|fail|use|record|fn|add|global|pass|forever)\\b"
    },
    {
      "name": "keyword.operator.logical.echo",
      "match": "\\b(and|or|not|xor|nand|nor|xnor|is)\\b"
    },
    {
      "name": "constant.language.echo",
      "match": "\\b(true|false|yes|no|nothing)\\b"
    },
    {
      "name": "constant.numeric.echo",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    {
      "name": "support.function.bio.echo",
      "match": "\\b(dna|gc|at|gc_count|base_counts|complement|reverse_complement|revcomp|transcribe|back_transcribe|translate|find_orfs|find_motif|tm|tm_basic|primer_check|primer_info|design_primers|pcr_program|restriction_sites|digest|enzymes|align|protein_mass|isoelectric_point|gravy|protein_info|dna_mass|parse_fasta|read_fasta|to_fasta|write_fasta|gel|dilute|copy_number|molarity|mutate|hamming|codon_usage|codon_table|random_dna)\\b(?=\\s*\\()"
    },
    {
      "name": "support.function.echo",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.echo",
      "match": "->|==|!=|<=|>=|\\+=|-=|\\*=|/=|//|[+\\-*/%^<>=]"
    }
  ],
  "repository": {
    "interp": {
      "name": "meta.interpolation.echo",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.echo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.echo"
        }
      },
      "patterns": [
        {
          "include": "source.echo"
        }
      ]
    }
  }
}