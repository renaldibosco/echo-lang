{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Echo",
  "scopeName": "source.echo",
  "patterns": [
    {
      "name": "comment.line.number-sign.echo",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.triple.echo",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#interp"
        }
      ]
    },
    {
      "name": "string.quoted.double.echo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.echo",
          "match": "\\\\."
        },
        {
          "include": "#interp"
        }
      ]
    },
    {
      "match": "\\b(define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.echo"
        },
        "2": {
          "name": "entity.name.function.echo"
        }
      }
    },
    {
      "match": "\\b(record)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.echo"
        },
        "2": {
          "name": "entity.name.type.echo"
        }
      }
    },
    {
      "name": "keyword.control.echo",
      "match": "\\b(set|to|say|ask|into|if|then|else|end|repeat|times|while|for|each|in|from|step|break|continue|define|return|try|catch|fail|use|as|record|fn|add|global)\\b"
    },
    {
      "name": "keyword.operator.logical.echo",
      "match": "\\b(and|or|not|xor|nand|nor|xnor)\\b"
    },
    {
      "name": "storage.type.echo",
      "match": "(?<=:\\s|:|->\\s|\\bof\\s)\\b(number|integer|text|boolean|list|map|function|any|dna|rna|protein|nothing)\\b"
    },
    {
      "name": "constant.language.echo",
      "match": "\\b(true|false|nothing)\\b"
    },
    {
      "name": "constant.numeric.echo",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    {
      "name": "entity.name.namespace.echo",
      "match": "\\b(bio|math|random|file|json|time|gates|cyber|stats|ml|ai)\\b(?=\\.)"
    },
    {
      "name": "support.function.echo",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.echo",
      "match": "->|==|!=|<=|>=|//|[+\\-*/%^<>]"
    }
  ],
  "repository": {
    "interp": {
      "name": "meta.interpolation.echo",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.echo"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.echo"
        }
      },
      "patterns": [
        {
          "include": "source.echo"
        }
      ]
    }
  }
}