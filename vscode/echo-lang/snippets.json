{
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "\t$0",
      "end"
    ]
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} then",
      "\t$2",
      "else",
      "\t$0",
      "end"
    ]
  },
  "for each": {
    "prefix": "foreach",
    "body": [
      "for each ${1:item} in ${2:items}",
      "\t$0",
      "end"
    ]
  },
  "for range": {
    "prefix": "for",
    "body": [
      "for ${1:i} from ${2:1} to ${3:10}",
      "\t$0",
      "end"
    ]
  },
  "repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} times",
      "\t$0",
      "end"
    ]
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "\t$0",
      "end"
    ]
  },
  "define": {
    "prefix": "define",
    "body": [
      "define ${1:name}(${2:value}: ${3:number}) -> ${4:number}",
      "\t$0",
      "\treturn ${2:value}",
      "end"
    ]
  },
  "record": {
    "prefix": "record",
    "body": [
      "record ${1:Sample}(${2:name}: ${3:text}, ${4:seq}: ${5:dna})"
    ]
  },
  "try": {
    "prefix": "try",
    "body": [
      "try",
      "\t$1",
      "catch ${2:problem}",
      "\tsay \"Problem {${2:problem}.code}:\", ${2:problem}.message",
      "end"
    ]
  },
  "primers": {
    "prefix": "primers",
    "body": [
      "set pair to bio.design_primers(${1:gene}, product_min: ${2:300}, product_max: ${3:800})",
      "say \"Forward: {pair.forward}  GC {pair.gc_forward}%  Tm {pair.tm_forward} °C\"",
      "say \"Reverse: {pair.reverse}  GC {pair.gc_reverse}%  Tm {pair.tm_reverse} °C\"",
      "say \"Product: {pair.product} bp\""
    ]
  }
}