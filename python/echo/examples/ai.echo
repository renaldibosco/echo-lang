# AI in Echo (needs your own key, saved only on your device)
# Run once:  ai.setup("claude", "YOUR-KEY")    or "gemini" / "openai"
say ai.status()

try
    set answer to ai.ask("In two lines, what does a GC clamp do in a PCR primer?")
    say answer

    # let the AI write Echo code for you
    set program to ai.code("count how many times ATG appears in a DNA sequence")
    say "AI wrote:"
    say program

    say ai.explain("ATGGCTAGCAAAGGAGAAGAAC")
catch problem
    say "AI is not ready:", problem.message
end
