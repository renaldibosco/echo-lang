# Your first Echo program
say "Hello from Echo!"

set name to "Ada"
set age: integer to 21
say "Hi {name}, next year you will be {age + 1}."

# lists and loops
set samples to ["leaf", "root", "stem"]
for each sample in samples
    say "Sample: " + sample
end

for i from 1 to 5
    if i == 3 then
        continue
    end
    say i, "squared is", i ^ 2
end

# functions with types
define greet(person: text, greeting: text = "Hello") -> text
    return greeting + ", " + person + "!"
end
say greet("Ada")
say greet("Grace", greeting: "Welcome")

# maps and records
set plasmid to {name: "pUC19", length: 2686}
say plasmid.name, "is", plasmid.length, "bp"

record Student(name: text, course: text)
set student to Student("Ada", "B.Sc. Biotechnology")
say student
say student.name + " studies " + student.course
