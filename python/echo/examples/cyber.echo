# Cyber-security basics (everything runs on your device)
set secret to "Meet at the lab at 5"
set hidden to cyber.caesar(secret, 3)
say "Caesar:", hidden
say "Back:", cyber.caesar(hidden, -3)

say "SHA-256 of 'echo':", cyber.sha256("echo")
say "Base64:", cyber.base64_encode("Echo language")

set key to "BIO"
set encoded to cyber.vigenere("ATTACK AT DAWN", key)
say "Vigenere:", encoded, "->", cyber.vigenere(encoded, key, decode: true)

for each password in ["password", "Lab2026", cyber.random_password(16)]
    set strength to cyber.password_strength(password)
    say password, "->", strength.label, "({strength.bits} bits)"
end

# crack a Caesar message by trying every shift
for each attempt in cyber.caesar_crack("Wkh jhqh lv JIS")[0:5]
    say attempt
end
