# Logic gates and bits
say 1 and 0, 1 or 0, 1 xor 1, 1 nand 1, 0 nor 0, 1 xnor 1, not 1

say truth_table("xor")

# make your own gate from other gates
define my_xor(a, b)
    return (a or b) and not (a and b)
end
say truth_table(my_xor)

# adders built from gates
say truth_table(half_adder)
say "1011 + 0110 =", add_binary("1011", "0110"), "=", from_binary(add_binary("1011", "0110"))

# bits
say to_binary(42, 8), to_hex(255), bit_and(12, 10), bit_xor(12, 10), shift_left(1, 4)
