# Data and small machine-learning models

# Bradford assay standard curve: protein (ug/mL) vs absorbance
set conc: list of number to [0, 125, 250, 500, 750, 1000]
set absorbance: list of number to [0.0, 0.11, 0.21, 0.43, 0.63, 0.84]
set fit to stats.linear_fit(conc, absorbance)
say "slope {format(fit.slope, 5)}, intercept {format(fit.intercept, 4)}, R² {format(fit.r2, 4)}"

# find an unknown sample's concentration from its absorbance
set unknown to 0.52
say "Sample with A = {unknown} has about {math.round((unknown - fit.intercept) / fit.slope)} ug/mL"

say "mean", stats.mean(absorbance), "stdev", format(stats.stdev(absorbance), 3)

# classify: is a sequence GC-rich? features = [gc %, length]
set X to [[35, 500], [38, 900], [42, 700], [55, 600], [61, 800], [66, 400], [30, 300], [58, 1000]]
set y to [0, 0, 0, 1, 1, 1, 0, 1]
set model to ml.train("logistic", X, y)
say "accuracy on training data:", ml.accuracy(model, X, y)
say "GC 63%, 750 bp ->", ml.predict(model, [63, 750])

set knn to ml.train("knn", X, y, k: 3)
say "kNN says GC 40% ->", ml.predict(knn, [40, 650])

# group samples with k-means
set groups to ml.cluster([[1, 2], [1.5, 1.8], [5, 8], [8, 8], [1, 0.6], [9, 11]], 2)
say "clusters:", groups.labels
